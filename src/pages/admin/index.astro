---
// src/pages/admin/index.astro
// Panel Administrativo estático - FOGÓN Restaurante
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>FOGÓN | Panel Administrativo</title>
        <meta name="robots" content="noindex, nofollow" />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Inter:wght@300;400;500;600&display=swap"
            rel="stylesheet"
        />

        <!-- Lucide Icons -->
        <script src="https://unpkg.com/lucide@latest" is:inline></script>
        <style is:inline>
            :root {
                --primary: #c9748a;
                --accent: #b8860b;
                --yellow: #d4af37;
                --dark-bg: #0f0b0d;
                --card-bg: rgba(35, 22, 28, 0.75);
                --border-color: rgba(255, 255, 255, 0.08);
                --text-primary: #fdf8f5;
                --text-secondary: #c4a8b0;
                --white: #ffffff;
                --success: #22c55e;
                --warning: #eab308;
                --danger: #ef4444;
                --info: #3b82f6;
                --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            body {
                font-family: "Inter", sans-serif;
                background-color: var(--dark-bg);
                color: var(--text-primary);
                line-height: 1.6;
                min-height: 100vh;
                overflow-x: hidden;
                background-image:
                    radial-gradient(
                        at 0% 0%,
                        rgba(201, 116, 138, 0.18) 0px,
                        transparent 50%
                    ),
                    radial-gradient(
                        at 100% 100%,
                        rgba(184, 134, 11, 0.12) 0px,
                        transparent 50%
                    );
                background-attachment: fixed;
            }

            /* Loading overlay */
            .page-loader {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: var(--dark-bg);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 9999;
                transition: opacity 0.5s;
            }

            /* Dashboard Layout */
            .dashboard-container {
                display: flex;
                min-height: 100vh;
            }
            .sidebar {
                width: 280px;
                background: rgba(15, 22, 42, 0.85);
                backdrop-filter: blur(12px);
                border-right: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                position: fixed;
                height: 100vh;
                z-index: 100;
                transition: var(--transition);
            }
            .sidebar-header {
                padding: 2rem 1.5rem;
                border-bottom: 1px solid var(--border-color);
            }
            .sidebar-menu {
                list-style: none;
                padding: 2rem 1rem;
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
                flex: 1;
            }
            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 0.8rem;
                padding: 0.9rem 1.2rem;
                color: var(--text-secondary);
                border-radius: 12px;
                font-weight: 500;
                font-size: 0.95rem;
                cursor: pointer;
                transition: var(--transition);
            }
            .sidebar-link:hover,
            .sidebar-link.active {
                color: var(--white);
                background: rgba(255, 255, 255, 0.05);
            }
            .sidebar-link.active {
                background: linear-gradient(
                    135deg,
                    rgba(0, 194, 255, 0.15) 0%,
                    rgba(255, 20, 147, 0.05) 100%
                );
                border-left: 3px solid var(--primary);
                color: var(--primary);
            }
            .sidebar-footer {
                padding: 1.5rem;
                border-top: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
            }
            .main-content {
                margin-left: 280px;
                flex: 1;
                padding: 2.5rem;
                min-width: 0;
                overflow-x: hidden;
                transition: var(--transition);
            }
            .main-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 2.5rem;
            }
            .main-title h1 {
                font-size: 2rem;
                font-family: "Outfit", sans-serif;
                color: var(--white);
                margin-bottom: 0.25rem;
            }
            .main-title p {
                color: var(--text-secondary);
                font-size: 0.95rem;
            }
            .metrics-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                gap: 1.5rem;
                margin-bottom: 2.5rem;
            }
            .metric-card {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: 20px;
                padding: 1.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
                transition: var(--transition);
            }
            .metric-card:hover {
                transform: translateY(-3px);
                border-color: rgba(255, 255, 255, 0.15);
            }
            .metric-info h3 {
                font-size: 0.85rem;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: 0.05em;
                margin-bottom: 0.5rem;
                font-weight: 600;
            }
            .metric-info p {
                font-size: 1.8rem;
                font-family: "Outfit", sans-serif;
                font-weight: 700;
                color: var(--white);
            }
            .metric-icon {
                width: 54px;
                height: 54px;
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
            }
            .metric-icon.blue {
                background: rgba(0, 194, 255, 0.15);
                color: var(--primary);
            }
            .metric-icon.pink {
                background: rgba(255, 20, 147, 0.15);
                color: var(--accent);
            }
            .metric-icon.yellow {
                background: rgba(255, 215, 0, 0.15);
                color: var(--yellow);
            }
            .metric-icon.green {
                background: rgba(34, 197, 94, 0.15);
                color: var(--success);
            }
            .dashboard-section {
                display: none;
                animation: fadeIn 0.4s ease-out forwards;
            }
            .dashboard-section.active {
                display: block;
            }
            @keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(10px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            .content-card {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: 24px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
                margin-bottom: 2rem;
                overflow: hidden;
            }
            .card-header {
                padding: 1.5rem 2rem;
                border-bottom: 1px solid var(--border-color);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .card-header h2 {
                font-size: 1.25rem;
                font-family: "Outfit", sans-serif;
                font-weight: 600;
                color: var(--white);
            }
            .card-actions {
                display: flex;
                gap: 0.75rem;
            }
            .btn-action {
                background: var(--accent);
                color: var(--white);
                border: none;
                border-radius: 10px;
                padding: 0.6rem 1.2rem;
                font-size: 0.85rem;
                font-weight: 600;
                cursor: pointer;
                transition: var(--transition);
                display: flex;
                align-items: center;
                gap: 0.4rem;
                text-decoration: none;
            }
            .btn-action:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(255, 20, 147, 0.3);
            }
            .btn-action.secondary {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid var(--border-color);
                color: var(--text-primary);
            }
            .btn-action.secondary:hover {
                background: rgba(255, 255, 255, 0.1);
                box-shadow: none;
            }
            .table-responsive {
                overflow-x: auto;
                width: 100%;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
                font-size: 0.9rem;
            }
            th {
                background: rgba(15, 22, 42, 0.4);
                padding: 1.2rem 1.5rem;
                color: var(--text-secondary);
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 0.05em;
                border-bottom: 1px solid var(--border-color);
            }
            td {
                padding: 1.2rem 1.5rem;
                border-bottom: 1px solid var(--border-color);
                color: var(--text-primary);
            }
            tr:last-child td {
                border-bottom: none;
            }
            tr:hover td {
                background: rgba(255, 255, 255, 0.01);
            }
            .status-badge {
                display: inline-flex;
                align-items: center;
                padding: 0.3rem 0.75rem;
                border-radius: 50px;
                font-size: 0.75rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                gap: 0.3rem;
            }
            .status-badge.pendiente {
                background: rgba(234, 179, 8, 0.15);
                color: var(--warning);
            }
            .status-badge.en_produccion {
                background: rgba(59, 130, 246, 0.15);
                color: var(--info);
            }
            .status-badge.listo_entrega {
                background: rgba(0, 194, 255, 0.15);
                color: var(--primary);
            }
            .status-badge.completado {
                background: rgba(34, 197, 94, 0.15);
                color: var(--success);
            }
            .status-badge.cancelado {
                background: rgba(239, 68, 68, 0.15);
                color: var(--danger);
            }
            .status-select {
                background: rgba(15, 22, 42, 0.9);
                border: 1px solid var(--border-color);
                color: var(--text-primary);
                padding: 0.4rem 0.6rem;
                border-radius: 8px;
                outline: none;
                font-size: 0.85rem;
                cursor: pointer;
                transition: var(--transition);
            }
            .status-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 8px rgba(0, 194, 255, 0.2);
            }
            .status-select option,
            .form-control option,
            select option {
                background-color: #0b0f19;
                color: var(--text-primary);
            }
            .form-group {
                margin-bottom: 1rem;
            }
            .form-group label {
                display: block;
                font-size: 0.85rem;
                color: var(--text-secondary);
                margin-bottom: 0.4rem;
                font-weight: 500;
            }
            .form-control {
                width: 100%;
                background: rgba(15, 22, 42, 0.6);
                border: 1px solid var(--border-color);
                border-radius: 10px;
                padding: 0.65rem 0.9rem;
                color: var(--text-primary);
                font-size: 0.9rem;
                outline: none;
                transition: var(--transition);
                font-family: inherit;
            }
            .form-control:focus {
                border-color: var(--primary);
                box-shadow: 0 0 10px rgba(0, 194, 255, 0.15);
            }
            .action-icon-btn {
                background: none;
                border: none;
                cursor: pointer;
                color: var(--text-secondary);
                padding: 0.3rem;
                border-radius: 6px;
                transition: var(--transition);
            }
            .action-icon-btn:hover {
                color: var(--white);
                background: rgba(255, 255, 255, 0.05);
            }
            .action-icon-btn.delete:hover {
                color: var(--danger);
                background: rgba(239, 68, 68, 0.1);
            }
            .action-icon-btn.edit:hover {
                color: var(--primary);
                background: rgba(0, 194, 255, 0.1);
            }

            /* Modales */
            .modal {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(11, 15, 25, 0.7);
                backdrop-filter: blur(8px);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 1000;
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.3s;
            }
            .modal.active {
                opacity: 1;
                pointer-events: auto;
            }
            .modal-content {
                background: rgba(22, 29, 49, 0.95);
                backdrop-filter: blur(16px);
                border: 1px solid var(--border-color);
                border-radius: 28px;
                padding: 2.5rem;
                width: 100%;
                max-width: 600px;
                box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
                transform: translateY(20px);
                transition: transform 0.3s;
            }
            .modal.active .modal-content {
                transform: translateY(0);
            }
            .modal-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 1.5rem;
            }
            .modal-header h3 {
                font-size: 1.4rem;
                font-family: "Outfit", sans-serif;
                color: var(--white);
            }
            .modal-close {
                background: none;
                border: none;
                color: var(--text-secondary);
                cursor: pointer;
                padding: 0.2rem;
                border-radius: 50%;
                transition: var(--transition);
            }
            .modal-close:hover {
                color: var(--white);
                background: rgba(255, 255, 255, 0.05);
            }
            .modal-body {
                max-height: 420px;
                overflow-y: auto;
                margin-bottom: 1.5rem;
                padding-right: 0.5rem;
            }
            .modal-footer {
                display: flex;
                justify-content: flex-end;
                gap: 1rem;
            }

            .order-meta-info {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1.2rem;
                background: rgba(15, 22, 42, 0.4);
                padding: 1.2rem;
                border-radius: 16px;
                margin-bottom: 1.5rem;
            }
            .order-meta-info p {
                font-size: 0.85rem;
                color: var(--text-secondary);
            }
            .order-meta-info p strong,
            .order-meta-info > div > strong {
                color: var(--white);
                display: block;
                font-size: 0.95rem;
                margin-top: 0.2rem;
            }

            .detail-item {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0.9rem 0;
                border-bottom: 1px solid var(--border-color);
            }
            .detail-item:last-child {
                border-bottom: none;
            }
            .detail-item-info {
                display: flex;
                align-items: center;
                gap: 0.8rem;
            }
            .detail-item-icon {
                width: 38px;
                height: 38px;
                background: rgba(255, 20, 147, 0.1);
                color: var(--accent);
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
            }
            .detail-item-name h4 {
                font-size: 0.95rem;
                color: var(--white);
                font-weight: 500;
            }
            .detail-item-name span {
                font-size: 0.8rem;
                color: var(--text-secondary);
            }
            .detail-item-qty {
                font-family: "Outfit", sans-serif;
                font-weight: 600;
                color: var(--primary);
                font-size: 1.05rem;
            }

            /* Collapsible */
            .collapsible-content {
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.4s ease-out;
            }
            .collapsible-content.expanded {
                max-height: 2000px;
            }

            .toast-container {
                position: fixed;
                bottom: 30px;
                right: 30px;
                z-index: 2000;
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
            }
            .toast {
                background: rgba(22, 29, 49, 0.9);
                backdrop-filter: blur(8px);
                border: 1px solid var(--border-color);
                border-left: 4px solid var(--primary);
                border-radius: 12px;
                padding: 1rem 1.5rem;
                min-width: 280px;
                color: var(--text-primary);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
                display: flex;
                align-items: center;
                gap: 0.8rem;
                font-size: 0.9rem;
                animation: slideIn 0.3s ease-out forwards;
            }
            .toast.success {
                border-left-color: var(--success);
            }
            .toast.error {
                border-left-color: var(--danger);
            }
        </style>
    </head>
    <body>
        <!-- Loading State Inicial -->
        <div class="page-loader" id="page-loader">
            <div style="text-align: center;">
                <i
                    data-lucide="loader-2"
                    class="spin"
                    style="width: 50px; height: 50px; color: var(--primary); margin-bottom: 1rem;"
                ></i>
                <p style="color: var(--text-secondary); font-size: 0.9rem; letter-spacing: 0.05em;">
                    Cargando Panel FOGÓN...
                </p>
            </div>
        </div>

        <div
            class="dashboard-container"
            id="dashboard-container"
            style="display: none;"
        >
            <div class="sidebar-overlay" id="sidebar-overlay"></div>

            <!-- Sidebar -->
            <aside class="sidebar" id="sidebar">
                <div class="sidebar-header">
                    <div
                        class="login-logo"
                        style="margin-bottom: 0; justify-content: flex-start; font-size: 1.4rem; display: flex; align-items: center; gap: 0.5rem; font-family: 'Outfit', sans-serif; font-weight: 700;"
                    >
                        <i
                            data-lucide="flame"
                            style="color: var(--primary);"
                        ></i>
                        <span class="logo-text">
                            FOG<span style="color: var(--accent);">ÓN</span>
                        </span>
                    </div>
                </div>
                <ul class="sidebar-menu">
                    <li>
                        <div
                            class="sidebar-link active"
                            data-target="section-metrics"
                        >
                            <i data-lucide="layout-dashboard"></i>
                            <span>Métricas Generales</span>
                        </div>
                    </li>
                    <li>
                        <div class="sidebar-link" data-target="section-orders">
                            <i data-lucide="shopping-bag"></i>
                            <span>Gestión Pedidos</span>
                        </div>
                    </li>
                    <li>
                        <div class="sidebar-link" data-target="section-sales">
                            <i data-lucide="trending-up"></i>
                            <span>Registro Ventas</span>
                        </div>
                    </li>
                    <li>
                        <div
                            class="sidebar-link"
                            data-target="section-inventory"
                        >
                            <i data-lucide="utensils"></i>
                            <span>Menú / Platos</span>
                        </div>
                    </li>
                </ul>
                <div class="sidebar-footer">
                    <button
                        class="btn-action secondary"
                        id="btn-open-change-password"
                        style="width: 100%; justify-content: center; margin-bottom: 0.5rem;"
                    >
                        <i data-lucide="key"></i>
                        <span>Cambiar Clave</span>
                    </button>
                    <div
                        class="sidebar-link"
                        id="btn-logout"
                        style="color: var(--danger); background: rgba(239, 68, 68, 0.05);"
                    >
                        <i data-lucide="log-out"></i>
                        <span>Cerrar Sesión</span>
                    </div>
                </div>
            </aside>

            <!-- Main Content -->
            <main class="main-content">
                <header
                    class="main-header"
                    style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; width: 100%; flex-wrap: wrap;"
                >
                    <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
                        <button
                            id="btn-sidebar-toggle"
                            class="btn-action secondary"
                            style="display: none; padding: 0.5rem; border-radius: 10px; width: 42px; height: 42px; justify-content: center; align-items: center; border: 1px solid var(--border-color); cursor: pointer;"
                        >
                            <i data-lucide="menu"></i>
                        </button>
                        <div class="main-title">
                            <h1 id="dashboard-title">Panel Administrativo</h1>
                            <p id="dashboard-subtitle">
                                Control de pedidos, ventas y menú de FOGÓN en
                                tiempo real.
                            </p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 1rem; flex-shrink: 0;">
                        <div id="admin-bcv-widget" style="display: flex; align-items: center; gap: 0.6rem; background: rgba(212, 175, 55, 0.1); border: 1px solid rgba(212, 175, 55, 0.3); padding: 0.4rem 0.8rem; border-radius: 12px;">
                            <span style="font-size: 1.1rem;">🇻🇪</span>
                            <div>
                                <span style="font-size: 0.72rem; color: var(--text-secondary); display: block; line-height: 1;">Tasa BCV</span>
                                <strong id="admin-bcv-val" style="font-size: 0.95rem; color: #D4AF37;">-- Bs.</strong>
                            </div>
                            <button id="btn-open-bcv-modal" class="btn-action secondary" style="padding: 0.3rem 0.6rem; font-size: 0.75rem; border-radius: 8px; margin-left: 0.2rem;" title="Ajustar Tasa BCV">
                                <i data-lucide="edit-2" style="width: 14px; height: 14px;"></i>
                            </button>
                        </div>
                        <div style="text-align: right;" id="user-info-badge">
                            <p
                                style="font-size: 0.85rem; font-weight: 600;"
                                id="admin-user-name"
                            >
                                Administrador
                            </p>
                            <span style="font-size: 0.75rem; color: var(--success); font-weight: 500; display: inline-flex; align-items: center; gap: 0.2rem;">
                                <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--success);"></span>{" "}
                                En línea
                            </span>
                        </div>
                    </div>
                </header>

                <!-- SECCIÓN 1: MÉTRICAS -->
                <div id="section-metrics" class="dashboard-section active">
                    <div class="metrics-grid">
                        <div class="metric-card">
                            <div class="metric-info">
                                <h3>Ventas Registradas</h3>
                                <p id="metric-sales-count">0</p>
                            </div>
                            <div class="metric-icon green">
                                <i data-lucide="trending-up"></i>
                            </div>
                        </div>
                        <div class="metric-card">
                            <div class="metric-info">
                                <h3>Pedidos Pendientes</h3>
                                <p id="metric-pending-orders">0</p>
                            </div>
                            <div class="metric-icon yellow">
                                <i data-lucide="clock"></i>
                            </div>
                        </div>
                        <div class="metric-card">
                            <div class="metric-info">
                                <h3>En Preparación</h3>
                                <p id="metric-prod-orders">0</p>
                            </div>
                            <div class="metric-icon blue">
                                <i data-lucide="cooking-pot"></i>
                            </div>
                        </div>
                        <div class="metric-card">
                            <div class="metric-info">
                                <h3>Platos en Menú</h3>
                                <p id="metric-prod-count">0</p>
                            </div>
                            <div class="metric-icon pink">
                                <i data-lucide="utensils"></i>
                            </div>
                        </div>
                    </div>
                    <div class="content-card">
                        <div class="card-header">
                            <h2>Pedidos Recientes</h2>
                            <button class="btn-action secondary view-all-orders-btn">
                                Ver todos
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table>
                                <thead>
                                    <tr>
                                        <th>ID Pedido</th>
                                        <th>Cliente</th>
                                        <th>Teléfono</th>
                                        <th>Artículos</th>
                                        <th>Fecha</th>
                                        <th>Estado</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="table-recent-orders">
                                    <tr>
                                        <td
                                            colspan="7"
                                            style="text-align: center; color: var(--text-secondary);"
                                        >
                                            Cargando pedidos recientes...
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN 2: PEDIDOS -->
                <div id="section-orders" class="dashboard-section">
                    <div class="content-card">
                        <div class="card-header">
                            <h2>
                                Todos los Pedidos Recibidos{" "}
                                <span
                                    id="orders-total-summary"
                                    style="font-size: 0.95rem; color: var(--accent); margin-left: 1rem; font-weight: 500;"
                                ></span>
                            </h2>
                            <div class="card-actions">
                                <button
                                    class="btn-action secondary"
                                    id="btn-refresh-orders"
                                >
                                    <i data-lucide="refresh-cw"></i> Actualizar
                                </button>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table>
                                <thead>
                                    <tr>
                                        <th>ID Pedido</th>
                                        <th>Cliente</th>
                                        <th>Teléfono</th>
                                        <th>Artículos</th>
                                        <th>Fecha</th>
                                        <th>Cambiar Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="table-all-orders">
                                    <tr>
                                        <td
                                            colspan="7"
                                            style="text-align: center; color: var(--text-secondary);"
                                        >
                                            No hay pedidos registrados en el
                                            sistema.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN 2.5: VENTAS -->
                <div id="section-sales" class="dashboard-section">
                    <div class="content-card">
                        <div class="card-header">
                            <h2>
                                Registro Histórico de Ventas{" "}
                                <span
                                    id="sales-total-amount"
                                    style="font-size: 0.95rem; color: var(--success); margin-left: 1rem; font-weight: 500;"
                                ></span>
                            </h2>
                            <div class="card-actions">
                                <button
                                    class="btn-action secondary"
                                    id="btn-refresh-sales"
                                >
                                    <i data-lucide="refresh-cw"></i> Sincronizar
                                </button>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table>
                                <thead>
                                    <tr>
                                        <th>ID Venta</th>
                                        <th>ID Pedido</th>
                                        <th>Cliente</th>
                                        <th>Teléfono</th>
                                        <th>Monto</th>
                                        <th>Método de Pago</th>
                                        <th>Fecha de Pago</th>
                                    </tr>
                                </thead>
                                <tbody id="table-all-sales">
                                    <tr>
                                        <td
                                            colspan="7"
                                            style="text-align: center; color: var(--text-secondary);"
                                        >
                                            Cargando registro de ventas...
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN 3: INVENTARIO / MENÚ -->
                <div id="section-inventory" class="dashboard-section">
                    <div class="content-card">
                        <div class="card-header">
                            <h2>Gestión del Menú / Platillos</h2>
                            <div class="card-actions">
                                <button
                                    class="btn-action"
                                    id="btn-toggle-product-form"
                                >
                                    <i data-lucide="plus"></i> Nuevo Plato
                                </button>
                                <button
                                    class="btn-action secondary"
                                    id="btn-refresh-products"
                                >
                                    <i data-lucide="refresh-cw"></i> Actualizar
                                </button>
                            </div>
                        </div>
                        <!-- Formulario Añadir/Editar Producto (colapsable) -->
                        <div
                            id="product-form-collapse"
                            class="collapsible-content"
                            style="padding: 0 2rem;"
                        >
                            <div style="padding: 2rem 0; border-bottom: 1px solid var(--border-color);">
                                <h3
                                    id="form-product-title"
                                    style="font-family: 'Outfit', sans-serif; font-size: 1.1rem; margin-bottom: 1.5rem; color: var(--primary);"
                                >
                                    Añadir Nuevo Plato
                                </h3>
                                <form id="product-form">
                                    <input
                                        type="hidden"
                                        id="prod-method"
                                        value="POST"
                                    />

                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
                                        <div class="form-group">
                                            <label for="prod-id">
                                                Slug / ID Único
                                            </label>
                                            <input
                                                type="text"
                                                id="prod-id"
                                                class="form-control"
                                                placeholder="ej: pabellon-criollo"
                                                required
                                            />
                                            <span style="font-size:0.75rem; color:var(--text-secondary);">
                                                Minúsculas, números o guiones.
                                            </span>
                                        </div>
                                        <div class="form-group">
                                            <label for="prod-name">
                                                Nombre del Plato
                                            </label>
                                            <input
                                                type="text"
                                                id="prod-name"
                                                class="form-control"
                                                placeholder="ej: Pabellón Criollo Especial"
                                                required
                                            />
                                        </div>
                                        <div class="form-group">
                                            <label for="prod-category">
                                                Categoría
                                            </label>
                                            <select
                                                id="prod-category"
                                                class="form-control"
                                            >
                                                <option value="entradas">
                                                    🥗 Entradas
                                                </option>
                                                <option value="principales">
                                                    🥩 Platos Principales
                                                </option>
                                                <option value="combos">
                                                    🪙 Combos
                                                </option>
                                                <option value="postres">
                                                    🍰 Postres
                                                </option>
                                                <option value="bebidas">
                                                    🥤 Bebidas
                                                </option>
                                            </select>
                                        </div>
                                    </div>

                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
                                        <div class="form-group">
                                            <label for="prod-price">
                                                Precio en USD ($)
                                            </label>
                                            <input
                                                type="number"
                                                id="prod-price"
                                                class="form-control"
                                                step="0.01"
                                                min="0"
                                                placeholder="0.00"
                                                required
                                            />
                                        </div>
                                        <div class="form-group">
                                            <label for="prod-icon">
                                                Icono (Lucide)
                                            </label>
                                            <input
                                                type="text"
                                                id="prod-icon"
                                                class="form-control"
                                                placeholder="ej: utensils, salad, cake, cup-soda"
                                            />
                                        </div>
                                        <div class="form-group">
                                            <label for="prod-image">
                                                Ruta de Imagen
                                            </label>
                                            <input
                                                type="text"
                                                id="prod-image"
                                                class="form-control"
                                                placeholder="assets/product_pabellon.webp"
                                                required
                                            />
                                        </div>
                                    </div>

                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
                                        <div class="form-group">
                                            <label for="prod-sizes">
                                                Opciones Rápidas (Separadas por
                                                comas)
                                            </label>
                                            <input
                                                type="text"
                                                id="prod-sizes"
                                                class="form-control"
                                                placeholder="ej: Res, Pollo, Mixto (o dejar vacío)"
                                            />
                                        </div>
                                        <div class="form-group">
                                            <label for="prod-active">
                                                Disponibilidad en Menú
                                            </label>
                                            <select
                                                id="prod-active"
                                                class="form-control"
                                            >
                                                <option value="1">
                                                    Disponible (Activo)
                                                </option>
                                                <option value="0">
                                                    Agotado / Pausado (Oculto)
                                                </option>
                                            </select>
                                        </div>
                                    </div>

                                    <div
                                        class="form-group"
                                        style="margin-bottom: 1.5rem;"
                                    >
                                        <label for="prod-description">
                                            Descripción
                                        </label>
                                        <textarea
                                            id="prod-description"
                                            class="form-control"
                                            rows="2"
                                            placeholder="Describe los ingredientes y presentación del plato..."
                                        ></textarea>
                                    </div>

                                    <div style="display: flex; justify-content: flex-end; gap: 1rem;">
                                        <button
                                            type="button"
                                            class="btn-action secondary"
                                            id="btn-cancel-edit"
                                            style="display: none;"
                                        >
                                            Cancelar Edición
                                        </button>
                                        <button
                                            type="submit"
                                            class="btn-action"
                                            id="btn-submit-product"
                                        >
                                            <i data-lucide="plus-circle"></i>{" "}
                                            Guardar Plato
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Imagen</th>
                                        <th>Slug</th>
                                        <th>Nombre</th>
                                        <th>Categoría</th>
                                        <th>Precio</th>
                                        <th>Opciones</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="table-products">
                                    <tr>
                                        <td
                                            colspan="8"
                                            style="text-align: center; color: var(--text-secondary);"
                                        >
                                            Cargando platillos...
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>

        <!-- Modal Detalles Pedido -->
        <div class="modal" id="order-detail-modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 id="modal-order-title">
                        Detalles del Pedido #FOG-XXXX
                    </h3>
                    <button class="modal-close" id="btn-close-modal">
                        <i data-lucide="x"></i>
                    </button>
                </div>

                <div class="modal-body" id="modal-order-body">
                    <!-- Información del Cliente -->
                    <div class="order-meta-info">
                        <div>
                            <p>Cliente</p>
                            <strong id="modal-client-name">-</strong>
                        </div>
                        <div>
                            <p>Contacto WhatsApp</p>
                            <strong id="modal-client-phone">-</strong>
                        </div>
                        <div>
                            <p>Fecha de Solicitud</p>
                            <strong id="modal-order-date">-</strong>
                        </div>
                        <div>
                            <p>Estado del Pedido</p>
                            <strong style="margin-top: 0.2rem;">
                                <span
                                    id="modal-order-status"
                                    class="status-badge pendiente"
                                >
                                    Pendiente
                                </span>
                            </strong>
                        </div>
                        <div>
                            <p>Total del Pedido</p>
                            <strong
                                id="modal-order-total"
                                style="color: var(--accent); font-size: 1.15rem; margin-top: 0.2rem;"
                            >
                                -
                            </strong>
                            <span id="modal-order-total-bs" style="font-size: 0.82rem; color: var(--text-secondary); display: block; margin-top: 2px;"></span>
                        </div>
                    </div>

                    <!-- Información de Entrega -->
                    <h4 style="font-family: 'Outfit', sans-serif; font-size: 1rem; color: var(--white); margin-top: 0.5rem; margin-bottom: 0.8rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.4rem;">
                        Información de Entrega
                    </h4>
                    <div
                        class="order-meta-info"
                        style="grid-template-columns: 1fr; gap: 0.6rem; margin-bottom: 1.2rem;"
                    >
                        <div>
                            <p>Método</p>
                            <strong id="modal-delivery-type">-</strong>
                        </div>
                        <div
                            id="modal-delivery-address-container"
                            style="display: none;"
                        >
                            <p>Dirección</p>
                            <strong id="modal-delivery-address">-</strong>
                        </div>
                        <div
                            id="modal-delivery-notes-container"
                            style="display: none;"
                        >
                            <p>Notas Adicionales</p>
                            <strong id="modal-delivery-notes">-</strong>
                        </div>
                    </div>

                    <!-- Información de Pago -->
                    <h4 style="font-family: 'Outfit', sans-serif; font-size: 1rem; color: var(--white); margin-top: 0.5rem; margin-bottom: 0.8rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.4rem;">
                        Datos de Pago
                    </h4>
                    <div
                        class="order-meta-info"
                        style="grid-template-columns: 1fr 1fr; gap: 0.8rem; margin-bottom: 1.2rem;"
                        id="modal-payment-info-container"
                    >
                        <div>
                            <p>Método de Pago</p>
                            <strong id="modal-payment-method">-</strong>
                        </div>
                        <div>
                            <p>Referencia</p>
                            <strong id="modal-payment-reference">-</strong>
                        </div>
                    </div>

                    <!-- Comprobante de Pago Adjunto -->
                    <div id="modal-receipt-container" style="display: none; background: rgba(15, 22, 42, 0.4); border: 1px solid var(--border-color); border-radius: 12px; padding: 1rem; margin-bottom: 1.2rem;">
                        <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.5rem; font-weight: 500;">
                            📸 Comprobante de Pago Adjunto:
                        </p>
                        <div style="display: flex; align-items: center; gap: 1rem;">
                            <img id="modal-receipt-thumb" src="" alt="Comprobante" style="width: 64px; height: 64px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border-color); cursor: pointer;" />
                            <div>
                                <button type="button" class="btn-action secondary" id="btn-view-receipt-modal" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">
                                    <i data-lucide="eye"></i> Ver Comprobante Completo
                                </button>
                                <span style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 4px;">Click para ampliar captura</span>
                            </div>
                        </div>
                    </div>

                    <!-- Lista de Productos en Pedido -->
                    <h4 style="font-family: 'Outfit', sans-serif; font-size: 1rem; color: var(--white); margin-bottom: 0.8rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.4rem;">
                        Artículos Solicitados
                    </h4>
                    <div id="modal-items-list">
                        <!-- Detalle cargado dinámicamente -->
                    </div>
                </div>

                <div class="modal-footer">
                    <button
                        class="btn-action secondary"
                        id="btn-modal-close-footer"
                    >
                        Cerrar
                    </button>
                    <a
                        href=""
                        target="_blank"
                        class="btn-action"
                        id="btn-modal-chat"
                        style="background: #25D366; box-shadow: 0 4px 12px rgba(37,211,102,0.3);"
                    >
                        <i data-lucide="message-circle"></i> Chatear por
                        WhatsApp
                    </a>
                </div>
            </div>
        </div>

        <!-- Modal Registrar Pago -->
        <div class="modal" id="payment-modal">
            <div class="modal-content" style="max-width: 480px;">
                <div class="modal-header">
                    <h3>Registrar Pago</h3>
                    <button class="modal-close" id="btn-close-payment-modal">
                        <i data-lucide="x"></i>
                    </button>
                </div>
                <form id="payment-form">
                    <div class="modal-body" style="max-height: 300px;">
                        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
                            Pedido:{" "}
                            <strong
                                id="payment-modal-order-id"
                                style="color: var(--primary);"
                            ></strong>
                        </p>
                        <div class="form-group">
                            <label for="payment-amount">
                                Monto Cobrado ($)
                            </label>
                            <input
                                type="number"
                                id="payment-amount"
                                class="form-control"
                                placeholder="0.00"
                                step="0.01"
                                min="0"
                                required
                            />
                        </div>
                        <div class="form-group">
                            <label for="payment-method-select">
                                Método de Pago
                            </label>
                            <select
                                id="payment-method-select"
                                class="form-control"
                            >
                                <option value="pago_movil">
                                    📱 Pago Móvil
                                </option>
                                <option value="zelle">🇺🇸 Zelle</option>
                                <option value="efectivo_usd">
                                    💵 Efectivo USD
                                </option>
                                <option value="efectivo_bs">
                                    💵 Efectivo Bs
                                </option>
                                <option value="punto">💳 Punto de Venta</option>
                            </select>
                        </div>
                        <div class="form-group" id="reference-group">
                            <label for="payment-reference">
                                Referencia / Confirmación
                            </label>
                            <input
                                type="text"
                                id="payment-reference"
                                class="form-control"
                                placeholder="Número de confirmación"
                            />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button
                            type="button"
                            class="btn-action secondary"
                            id="btn-cancel-payment-modal"
                        >
                            Cancelar
                        </button>
                        <button
                            type="submit"
                            class="btn-action"
                            id="btn-confirm-payment"
                            style="background: var(--success); box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);"
                        >
                            <i data-lucide="check-circle"></i> Confirmar Pago
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Modal Cambiar Contraseña -->
        <div class="modal" id="change-password-modal">
            <div class="modal-content" style="max-width: 440px;">
                <div class="modal-header">
                    <h3>Cambiar Contraseña</h3>
                    <button class="modal-close" id="btn-close-password-modal">
                        <i data-lucide="x"></i>
                    </button>
                </div>
                <form id="change-password-form">
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="current-password-input">
                                Contraseña Actual
                            </label>
                            <input
                                type="password"
                                id="current-password-input"
                                class="form-control"
                                required
                                placeholder="••••••••"
                            />
                        </div>
                        <div class="form-group">
                            <label for="new-password-input">
                                Nueva Contraseña (mínimo 8 caracteres)
                            </label>
                            <input
                                type="password"
                                id="new-password-input"
                                class="form-control"
                                minlength="8"
                                required
                                placeholder="••••••••"
                            />
                        </div>
                        <div class="form-group">
                            <label for="confirm-password-input">
                                Confirmar Nueva Contraseña
                            </label>
                            <input
                                type="password"
                                id="confirm-password-input"
                                class="form-control"
                                minlength="8"
                                required
                                placeholder="••••••••"
                            />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button
                            type="button"
                            class="btn-action secondary"
                            id="btn-cancel-password-modal"
                        >
                            Cancelar
                        </button>
                        <button
                            type="submit"
                            class="btn-action"
                            id="btn-submit-password"
                        >
                            <i data-lucide="save"></i> Actualizar Clave
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Toast Container -->
        <div class="toast-container" id="toast-container"></div>

        <script src="/admin.js" is:inline></script>
        <script is:inline>
            lucide.createIcons();

            const style = document.createElement("style");
            style.innerHTML = `
      @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
      .spin { display: inline-block; animation: spin 1s linear infinite; }
    `;
            document.head.appendChild(style);

            window.addEventListener("DOMContentLoaded", () => {
                if (typeof checkSession === "function") {
                    checkSession();
                }
            });
        </script>
    </body>
</html>
